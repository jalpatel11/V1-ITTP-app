# Backend Configuration Environment Variables Template
APP_NAME="Community Tourism Portal API"
ENVIRONMENT="development"
DEBUG=True
API_PORT=8000
API_HOST="0.0.0.0"

# Database Configuration (PostgreSQL/PostGIS or fallback SQLite for local execution)
# PostgreSQL example: postgresql://user:password@localhost:5432/tourism_db
DATABASE_URL="sqlite:///./tourism_portal.db"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
